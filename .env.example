# Deja esta variable vacía para usar el proxy de desarrollo (vite.config.ts -> http://localhost:8000)
# En producción apunta al dominio del backend Laravel, por ejemplo: https://api.miestudio.com/api
VITE_API_URL=

# WebSockets (Laravel Reverb) para eventos en tiempo real de agenda y expedientes
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
